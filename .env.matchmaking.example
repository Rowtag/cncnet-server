# Environment for the matchmaking instance (docker-compose.matchmaking.yml).
# Copy to .env in the matchmaking directory, fill in, then: chmod 600 .env
#
# Keep the real file out of git - *.env is ignored, this example is not.

# Shown in the master list. Mark it as matchmaking so operators can tell the two apart.
CNCNET_SERVER__NAME=Your Server Name (Matchmaking)

# Dashboard login on port 1338. Without it the dashboard drops authentication
# and its CSRF protection along with it, and binds on all interfaces.
CNCNET_MAINTENANCE__PASSWORD=

# Master server registration. Same value the game tunnel uses.
CNCNET_MASTERSERVER__PASSWORD=

# Absolute path to the country database, usually the one the game tunnel already has.
# Leave unset to look for ./dbip-country-lite.mmdb next to this file.
GEO_DB=/opt/cncnet/dbip-country-lite.mmdb
