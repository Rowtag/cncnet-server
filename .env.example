# Copy this file to .env and fill in the values. The real .env is gitignored.
# These are read by docker-compose and passed to the container as environment
# variables. Nested config keys use double underscores (Section__Key).

# Password protecting the WebMonitor maintenance dashboard on port 1337.
# Leave empty to keep the dashboard unauthenticated (NOT recommended).
CNCNET_MAINTENANCE__PASSWORD=

# Password for registering with the master server (optional).
CNCNET_MASTERSERVER__PASSWORD=
